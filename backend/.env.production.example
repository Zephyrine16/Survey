SPRING_PROFILES_ACTIVE=prod
# Runtime SQL is restricted; Flyway uses a separate schema-owner credential.
DB_USERNAME=survey_runtime
FLYWAY_USER=neondb_owner
SEEDERS_ENABLED=false
DB_SSL_MODE=verify-full
# PEM root CA trusted for the Neon server certificate, mounted in the container.
DB_SSL_ROOT_CERT=/app/certs/database-root-ca.pem
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SURVEY_COOKIE_SECURE=true
JWT_EXPIRATION_MS=900000
CORS_ALLOWED_ORIGINS=https://survey-xi-ten.vercel.app
SERVER_FORWARD_HEADERS_STRATEGY=none
SECURITY_TRUSTED_PROXIES_ENABLED=true
# Set to verified immediate upstream proxy IPs/CIDRs; never use 0.0.0.0/0.
SECURITY_TRUSTED_PROXY_ADDRESSES=
SECURITY_MAINTENANCE_ENABLED=false
