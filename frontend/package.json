    "format": "prettier --write --experimental-cli src/",
    "test:unit": "vitest"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "vue": "^3.5.43",
    "vue-router": "^5.0.3"
  },
  "devDependencies": {
